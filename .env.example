APP_NAME=ConvertVault
APP_ENV=development
APP_URL=http://localhost:3000
SECRET_KEY=change-me-to-a-random-string-at-least-32-characters
POSTGRES_PASSWORD=change-me
APP_DOMAIN=localhost
DATABASE_URL=postgresql+psycopg://convertvault:change-me@postgres:5432/convertvault
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=convertvault
S3_SECRET_KEY=change-me
S3_BUCKET=convertvault
S3_REGION=us-east-1
LOCAL_STORAGE_PATH=/data/files
MAX_UPLOAD_SIZE=536870912
MAX_BATCH_SIZE=20
DEFAULT_USER_QUOTA=10737418240
JOB_TIMEOUT_IMAGE=600
JOB_TIMEOUT_PDF=1800
JOB_TIMEOUT_OFFICE=900
JOB_TIMEOUT_GENERAL=900
WORKER_CONCURRENCY_IMAGE=2
WORKER_CONCURRENCY_PDF=1
WORKER_CONCURRENCY_OFFICE=1
WORKER_CONCURRENCY_GENERAL=2
ENABLE_CLAMAV=false
CLAMAV_HOST=clamav
ENABLE_PUBLIC_SHARING=false
ENABLE_CONTENT_INDEXING=true
TRASH_RETENTION_DAYS=30
TEMP_RETENTION_HOURS=24
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
TOTP_ISSUER=ConvertVault
NEXT_PUBLIC_API_URL=http://localhost:8000
