# Copy to .env.folio (never commit it) and replace every value.
FOLIO_PUBLIC_URL=https://folio.local
FOLIO_SECRET_KEY=generate-with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FOLIO_DB_PASSWORD=generate-with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
FOLIO_CPU_WORKERS=2
FOLIO_MAX_UPLOAD_BYTES=209715200
